{
  "name": "quynguyen-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend-express"
  ],
  "scripts": {
    "dev:ui": "yarn workspace frontend dev",
    "dev:api": "yarn workspace backend-express dev",
    "build": "yarn workspace frontend build && yarn workspace backend-express build",
    "start": "yarn build && yarn workspace backend-express start",
    "migrate": "yarn workspace backend-express migrate",
    "dev:all": "concurrently \"yarn dev:ui\" \"yarn dev:api\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}