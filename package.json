{
  "name": "quynguyen-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend-express"
  ],
  "scripts": {
    "dev:ui": "cd frontend && yarn dev",
    "dev:server": "cd backend-express && yarn dev",
    "build": "yarn workspace frontend build && yarn workspace backend-express build",
    "start": "yarn workspace backend-express start",
    "migrate": "yarn workspace backend-express migrate"
  }
}
