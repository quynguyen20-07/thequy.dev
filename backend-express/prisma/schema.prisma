datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  role           String
  bio            String
  bioParagraphs  String[]
  statusBadge    String?
  email          String
  avatar         String?
  phone          String?
  location       String?
  resume         String?
  github         String?
  linkedin       String?
}

model HomeStat {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  value String
  label String @unique
  order Int    @default(0)
}

model ContactMethod {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  label       String
  value       String
  href        String
  description String
  iconType    String // email | github | linkedin | phone | twitter | etc.
  color       String
  iconColor   String
  order       Int    @default(0)
}

model PageSeo {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  page        String @unique // home | about | contact | projects
  title       String
  description String
  keywords    String
  path        String
}


model Project {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  slug             String   @unique
  title            String
  role             String
  company          String
  period           String
  shortDescription String
  description      String
  responsibilities String[]
  achievements     String[]
  tech             String[]
  category         String
  featured         Boolean  @default(false)
  color            String
  icon             String
  link             String?
}

model Experience {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  company     String
  role        String
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String
  tech        String[]
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt
}

model Skill {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  category  String    @unique
  items     String[]
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Highlight {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  icon        String
  title       String   @unique
  description String
  color       String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  degree      String
  institution String
  period      String
  note        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  email    String  @unique
  password String
  role     String  @default("USER") // ADMIN | USER
}

